# =============================================================================
# FRONTEND CLIENT ENVIRONMENT CONFIGURATION (.env.example)
# =============================================================================
# Sao chép tệp này thành .env trong thư mục frontend/:
#   cp .env.example .env
# =============================================================================

# Địa chỉ API Gateway (Spring Cloud Gateway)
VITE_API_URL=http://localhost:8080

# Địa chỉ máy chủ định danh Keycloak OIDC IAM
VITE_KEYCLOAK_URL=http://localhost:8180

# Địa chỉ WebSocket STOMP Endpoint (thông báo đơn hàng thời gian thực)
VITE_WS_URL=ws://localhost:8085/ws
